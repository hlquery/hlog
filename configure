#!/usr/bin/env perl
#
# hlog - Live log pipeline for hlquery.
#

use v5.26.0;
use strict;
use warnings FATAL => qw(all);

use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Spec::Functions qw(catdir catfile rel2abs);
use FindBin qw($RealDir);

use lib $RealDir;
use make::configure::cli qw(parse_cli_options);
use make::configure::console qw(
    detect_terminal_support
    get_char_map
    print_error
    print_header
    print_section
    print_status
    print_step
    print_success
    print_warning
);
use make::configure::files qw(
    check_runtime_writable
    create_required_directories
    generate_from_template
    generate_hlog_wrapper
    generate_version_script
);
use make::configure::probes qw(run_compile_probe);
use make::configure::system qw(
    command_exists
    default_cxx
    get_compiler_version
    get_cpu_count
    get_make_command
    get_system_name
    get_version_from_script
    platform_module_suffix
);

$| = 1;

$SIG{INT} = sub {
    print "\n\033[91mInterrupted by user. Exiting.\033[0m\n";
    exit 1;
};

use constant {
    BOLD => "\033[1m",
    RESET => "\033[0m",
    BRIGHT_BLUE => "\033[94m",
    OKGREEN => "\033[92m",
    PROJECT_NAME => 'hlog Pipeline',
    RUN_DIR => 'run',
};

my $script_path = $0;
if ($script_path !~ m{^/}) {
    $script_path = rel2abs($script_path);
}
my $base_path = abs_path(dirname($script_path));
my $root_path = abs_path(catfile($base_path, '..', '..'));
my %vars;
my %probe;

my $ansi_supported = detect_terminal_support();
my %char_map = get_char_map($ansi_supported);

%vars = (
    CXX => default_cxx(),
    CXXFLAGS => $ENV{CXXFLAGS} || '',
    LDFLAGS => $ENV{LDFLAGS} || '',
    SOCKETENGINE_NAME => 'poll',
    HLQUERY_VERSION => get_version_from_script(
        base_path => $base_path,
        root_path => $root_path,
    ),
    HLQUERY_SYSTEM => get_system_name(),
    HLOG_BASE_DIR => $base_path,
    HLQUERY_CONFIG_DIR => catfile($root_path, 'run', 'conf'),
    HLQUERY_DATA_DIR => catfile($root_path, 'run', 'data'),
    HLQUERY_LOG_DIR => catfile($root_path, 'run', 'logs'),
    HLQUERY_ADMIN_DIR => catfile($root_path, 'run'),
    HLQUERY_PID_DIR => catfile($root_path, 'run'),
    HLQUERY_SSL_DIR => catfile($root_path, 'run', 'ssl'),
    HLQUERY_DEFAULT_HTTP_PORT => 9200,
    HLQUERY_MAX_THREADS => get_cpu_count(),
    HLOG_SAMPLE_FILE => catfile($root_path, 'tests', 'sample.txt'),
    HLOG_INPUT_PATH => 'tests/file.txt',
    HLOG_INPUT_METHOD => 'auto',
    HLOG_INPUT_START => 'end',
    HLOG_INPUT_REFRESH_MS => '1000',
    HLOG_ENVIRONMENT => 'dev',
    HLOG_HOST_VALUE => 'localhost',
    HLOG_TAGS_VALUE => 'log_line',
    HLOG_INCLUDE_DATE => 'true',
    HLOG_INCLUDE_TAGS => 'true',
    HLOG_OUTPUT_ENDPOINT => 'http://127.0.0.1:9200',
    HLOG_OUTPUT_COLLECTION => 'logs',
    HLOG_OUTPUT_AUTH_METHOD => 'bearer',
    HLOG_OUTPUT_AUTH_TOKEN => '',
    HLOG_OUTPUT_TIMEOUT => '5',
    HLOG_FAILURE_BUFFER => '../../run/data/hlog_failed.log',
    HLOG_FAILURE_BUFFER_ENABLED => 'true',
    HLOG_MODULE_SUFFIX => platform_module_suffix(),
);

parse_cli_options(vars => \%vars);

print_header(
    ansi_supported => $ansi_supported,
    project_name => PROJECT_NAME,
);

print_section(
    ansi_supported => $ansi_supported,
    title => 'Environment',
);
$probe{compiler_exists} = command_exists($vars{CXX});
$probe{make_exists} = command_exists(get_make_command());
$probe{compiler_version} = $probe{compiler_exists} ? get_compiler_version($vars{CXX}) : 'not found';

print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'System',
    value => $vars{HLQUERY_SYSTEM},
);
if ($probe{compiler_exists}) {
    print_success(
        ansi_supported => $ansi_supported,
        char_map => \%char_map,
        description => 'Compiler',
        value => $vars{CXX},
    );
    print_success(
        ansi_supported => $ansi_supported,
        char_map => \%char_map,
        description => 'Compiler version',
        value => $probe{compiler_version},
    );
} else {
    print_error(
        ansi_supported => $ansi_supported,
        char_map => \%char_map,
        description => 'Compiler',
        value => $vars{CXX},
    );
    die "Compiler not found: $vars{CXX}\n";
}
if ($probe{make_exists}) {
    print_success(
        ansi_supported => $ansi_supported,
        char_map => \%char_map,
        description => 'Make tool',
        value => get_make_command(),
    );
} else {
    print_error(
        ansi_supported => $ansi_supported,
        char_map => \%char_map,
        description => 'Make tool',
        value => get_make_command(),
    );
    die "Required make tool not found: " . get_make_command() . "\n";
}
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'CPU threads',
    value => $vars{HLQUERY_MAX_THREADS},
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Project root',
    value => $base_path,
);

print_section(
    ansi_supported => $ansi_supported,
    title => 'Feature Probes',
);
$probe{cxx20} = run_compile_probe(
    name => 'cxx20',
    source => '#include <iostream>
int main() { auto v = 42; std::cout << v; return 0; }',
    base_path => $base_path,
    root_path => $root_path,
    cxx => $vars{CXX},
    cxxflags => $vars{CXXFLAGS},
    ldflags => $vars{LDFLAGS},
);
$probe{filesystem} = run_compile_probe(
    name => 'filesystem',
    source => '#include <filesystem>
int main() { std::filesystem::path p{"."}; return p.empty(); }',
    base_path => $base_path,
    root_path => $root_path,
    cxx => $vars{CXX},
    cxxflags => $vars{CXXFLAGS},
    ldflags => $vars{LDFLAGS},
);
$probe{sockets} = run_compile_probe(
    name => 'sockets',
    source => $^O eq 'MSWin32'
        ? '#include <winsock2.h>
int main() { SOCKET fd = socket(AF_INET, SOCK_STREAM, 0); return fd == INVALID_SOCKET; }'
        : '#include <sys/socket.h>
int main() { int fd = socket(AF_INET, SOCK_STREAM, 0); return fd < 0; }',
    base_path => $base_path,
    root_path => $root_path,
    cxx => $vars{CXX},
    cxxflags => $vars{CXXFLAGS},
    ldflags => $vars{LDFLAGS},
);
$probe{poll} = run_compile_probe(
    name => 'poll',
    source => $^O eq 'MSWin32'
        ? 'int main() { return 0; }'
        : '#include <poll.h>
int main() { struct pollfd pfd{}; return poll(&pfd, 0, 0); }',
    base_path => $base_path,
    root_path => $root_path,
    cxx => $vars{CXX},
    cxxflags => $vars{CXXFLAGS},
    ldflags => $vars{LDFLAGS},
);
$probe{inotify} = run_compile_probe(
    name => 'inotify',
    source => $^O eq 'MSWin32'
        ? 'int main() { return 0; }'
        : '#include <sys/inotify.h>
int main() { int fd = inotify_init1(IN_NONBLOCK); return fd < 0; }',
    base_path => $base_path,
    root_path => $root_path,
    cxx => $vars{CXX},
    cxxflags => $vars{CXXFLAGS},
    ldflags => $vars{LDFLAGS},
);

print_status(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    status => $probe{cxx20} ? 'OK' : 'ERROR',
    description => 'C++20 compiler support',
    value => $probe{cxx20} ? 'available' : 'no',
);
print_status(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    status => $probe{filesystem} ? 'OK' : 'ERROR',
    description => 'std::filesystem',
    value => $probe{filesystem} ? 'available' : 'no',
);
print_status(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    status => $probe{sockets} ? 'OK' : 'ERROR',
    description => 'TCP sockets',
    value => $probe{sockets} ? 'available' : 'no',
);
print_status(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    status => $probe{poll} ? 'OK' : 'ERROR',
    description => $^O eq 'MSWin32' ? 'poll loop backend' : 'poll(2)',
    value => $probe{poll} ? 'available' : 'no',
);
print_status(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    status => $probe{inotify} ? 'AVAIL' : 'SKIP',
    description => 'inotify',
    value => ($^O eq 'MSWin32' || !$probe{inotify}) ? 'not available' : 'available',
);

if (!$probe{cxx20} || !$probe{filesystem} || !$probe{sockets} || !$probe{poll}) {
    die "Required platform/compiler probes failed\n";
}

print_section(
    ansi_supported => $ansi_supported,
    title => 'Generation',
);
print_step(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Generating version script',
);
generate_version_script(
    base_path => $base_path,
    version => $vars{HLQUERY_VERSION},
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Generated version script',
    value => catfile($base_path, 'src', 'version.sh'),
);

print_step(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Generating config header',
);
generate_from_template(
    template_path => catfile($base_path, 'make', 'config.h.tpl'),
    output_path => catfile($base_path, 'include', 'core', 'config.h'),
    vars => \%vars,
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Generated config header',
    value => catfile($base_path, 'include', 'core', 'config.h'),
);

print_step(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Generating Makefile',
);
generate_from_template(
    template_path => catfile($base_path, 'make', 'makefile.tpl'),
    output_path => catfile($base_path, 'Makefile'),
    vars => \%vars,
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Generated Makefile',
    value => catfile($base_path, 'Makefile'),
);

print_step(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Generating hlog wrapper',
);
if (generate_hlog_wrapper(
    base_path => $base_path,
    vars => \%vars,
    run_dir => RUN_DIR,
)) {
    print_success(
        ansi_supported => $ansi_supported,
        char_map => \%char_map,
        description => 'Generated run/hlog wrapper',
        value => catfile($base_path, RUN_DIR, 'hlog'),
    );
} else {
    print_warning(
        ansi_supported => $ansi_supported,
        char_map => \%char_map,
        description => 'hlog template not found',
        value => catfile($base_path, 'make', 'hlog.tpl'),
    );
}

print_step(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Generating pipeline config',
);
my $pipeline_generated = generate_from_template(
    template_path => catfile($base_path, 'make', 'hlog.conf.tpl'),
    output_path => catfile($base_path, 'run', 'conf', 'hlog.conf'),
    vars => \%vars,
    preserve_existing => 1,
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => $pipeline_generated ? 'Generated pipeline config' : 'Preserved pipeline config',
    value => catfile($base_path, 'run', 'conf', 'hlog.conf'),
);

print_step(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Generating modules config',
);
my $modules_generated = generate_from_template(
    template_path => catfile($base_path, 'make', 'modules.conf.tpl'),
    output_path => catfile($base_path, 'run', 'conf', 'modules.conf'),
    vars => \%vars,
    preserve_existing => 1,
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => $modules_generated ? 'Generated modules config' : 'Preserved modules config',
    value => catfile($base_path, 'run', 'conf', 'modules.conf'),
);

print_section(
    ansi_supported => $ansi_supported,
    title => 'Runtime',
);
my $created_dirs = create_required_directories(base_path => $base_path);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Directory structure',
    value => $created_dirs > 0 ? "Created $created_dirs directories" : 'All directories validated',
);
my $runtime_root = catdir($base_path, RUN_DIR);
my $runtime_writable = check_runtime_writable(catdir($runtime_root, 'logs'));
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Config source',
    value => $vars{HLQUERY_CONFIG_DIR},
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Log source',
    value => $vars{HLQUERY_LOG_DIR},
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Local runtime',
    value => $runtime_root,
);
print_status(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    status => $runtime_writable ? 'OK' : 'ERROR',
    description => 'Runtime write test',
    value => $runtime_writable ? 'passed' : 'failed',
);

if (!$runtime_writable) {
    die "Cannot write to hlog runtime tree\n";
}

print_section(
    ansi_supported => $ansi_supported,
    title => 'Summary',
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Binary output',
    value => catfile($base_path, 'build', 'bin', 'hlog'),
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Wrapper',
    value => catfile($base_path, 'run', 'hlog'),
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Run command',
    value => 'cd etc/hlog && ' . get_make_command(),
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Pipeline config',
    value => catfile($base_path, 'run', 'conf', 'hlog.conf'),
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Modules config',
    value => catfile($base_path, 'run', 'conf', 'modules.conf'),
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Kernel watcher',
    value => $probe{inotify} ? 'inotify available' : 'poll fallback',
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Pipeline input',
    value => "$vars{HLOG_INPUT_PATH} ($vars{HLOG_INPUT_METHOD}/$vars{HLOG_INPUT_START})",
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Pipeline output',
    value => "$vars{HLOG_OUTPUT_COLLECTION} @ $vars{HLOG_OUTPUT_ENDPOINT}",
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Environment tag',
    value => $vars{HLOG_ENVIRONMENT},
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Include date',
    value => $vars{HLOG_INCLUDE_DATE},
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Include tags',
    value => $vars{HLOG_INCLUDE_TAGS},
);
print_success(
    ansi_supported => $ansi_supported,
    char_map => \%char_map,
    description => 'Timeout',
    value => $vars{HLOG_OUTPUT_TIMEOUT} . 's',
);

my $bold_start = $ansi_supported ? BOLD : "";
my $reset_end = $ansi_supported ? RESET : "";
my $okgreen_start = $ansi_supported ? OKGREEN : "";
my $bright_blue_start = $ansi_supported ? BRIGHT_BLUE : "";
my $make_cmd = get_make_command();
my $make_jobs = get_cpu_count() || 1;
my $build_cmd = $make_cmd;

if ($make_jobs > 1) {
    $build_cmd = "$make_cmd -j$make_jobs";
}

print "\n"
    . $bold_start
    . $okgreen_start
    . "  Configuration Complete!"
    . $reset_end
    . "\n\n";

print "  " . $char_map{'arrow'} . " " . $bold_start . $bright_blue_start . "Documentation:" . $reset_end . " https://docs.hlquery.com/\n";
print "  " . $char_map{'arrow'} . " " . $bold_start . $bright_blue_start . "Issues:" . $reset_end . " https://github.com/hlquery/hlquery/issues\n";

print_section(
    ansi_supported => $ansi_supported,
    title => 'Next Steps',
);
print "  " . $char_map{'asterisk'} . " To build the project, run:\n";
print "    " . $bold_start . $build_cmd . $reset_end . "\n\n";
print "  " . $char_map{'asterisk'} . " To install locally, run:\n";
print "    " . $bold_start . "$make_cmd install" . $reset_end . "\n\n";
